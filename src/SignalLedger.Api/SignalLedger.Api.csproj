<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Self-hosted Kestrel artifact: do not generate an IIS web.config on publish. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignalLedger.Domain\SignalLedger.Domain.csproj" />
    <ProjectReference Include="..\SignalLedger.Infrastructure\SignalLedger.Infrastructure.csproj" />
  </ItemGroup>

</Project>
