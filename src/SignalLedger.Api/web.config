<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for SignalLedger (framework-dependent, ASP.NET Core Module V2, in-process).
  Requires the .NET 10 Hosting Bundle. Application Initialization / preload / AlwaysRunning are configured
  on the server by scripts/deploy-iis.ps1 (applicationHost.config), not here, so this file stays valid on
  IIS installations without the Application Initialization feature. See docs/IIS_DEPLOYMENT.md.
  Keep the SQLite database outside this folder (SignalLedger__DataDirectory).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\SignalLedger.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Matches the API's 5 MB CSV upload limit (plus multipart overhead). -->
          <requestLimits maxAllowedContentLength="6291456" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
